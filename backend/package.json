{
  "name": "memora-backend",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node -r tsconfig-paths/register src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "postinstall": "npm run build",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit",
    "migrate": "ts-node -r tsconfig-paths/register src/db/migrate.ts",
    "migrate:rollback": "ts-node -r tsconfig-paths/register src/db/migrate-rollback.ts",
    "init-db": "ts-node -r tsconfig-paths/register src/db/init-db.ts"
  },
  "dependencies": {
    "express": "4.18.2",
    "cors": "2.8.5",
    "dotenv": "16.3.1",
    "pg": "8.11.3",
    "axios": "1.6.7",
    "bcrypt": "5.1.1",
    "jsonwebtoken": "9.0.3",
    "redis": "4.6.13",
    "ws": "8.16.0",
    "uuid": "9.0.1",
    "express-rate-limit": "7.1.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/node": "^20.0.0",
    "@types/bcrypt": "^5.0.0",
    "ts-node": "^10.9.0",
    "tsconfig-paths": "^4.2.0"
  }
}
