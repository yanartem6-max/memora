# Production Environment Variables for MEMORA

# Server
PORT=3001
NODE_ENV=production

# Frontend URLs
NEXT_PUBLIC_APP_URL=https://memora.up.railway.app
NEXT_PUBLIC_API_URL=https://memora.up.railway.app/api
NEXT_PUBLIC_TELEGRAM_BOT_TOKEN=your_bot_token_here

# Backend
JWT_SECRET=change_me_to_random_32_char_string_minimum
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_BOT_USERNAME=your_bot_username

# Database (Auto-provided by Railway PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/railway

# Redis (Optional - for caching)
REDIS_URL=redis://localhost:6379

# Solana (Production)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_NETWORK=mainnet-beta

# Encryption
ENCRYPTION_KEY=change_me_to_32_char_encryption_key

# Telegram
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash
